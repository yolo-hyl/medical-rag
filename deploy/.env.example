# =============================================================================
# 基础服务配置模板
# 首次执行 ./start.sh 时会自动复制为 .env，并为各服务生成随机密码。
# .env 不入库；Python 代码（ConfigLoader）也会读取 .env 中的密码。
#
# 注意：PostgreSQL / Neo4j 的密码只在首次初始化数据目录时写入，
#      之后修改 .env 中的密码不会改变已有数据库的密码。
# =============================================================================

# 镜像仓库。Docker Hub 匿名拉取受限（429）或网络不通时，可换成镜像源，例如：
#   REGISTRY=mirror.gcr.io
#   REGISTRY=docker.m.daocloud.io
REGISTRY=docker.io

# 端口绑定地址。默认只监听本机；需要其他机器访问时改为 0.0.0.0
BIND_ADDR=127.0.0.1

# 数据目录（相对 deploy/ 目录），所有服务的数据、日志都落在这里
DATA_DIR=./volumes

# ---------------- Milvus（向量库）----------------
MILVUS_VERSION=v2.6.0
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091

# ---------------- PostgreSQL（用户、会话、任务元数据）----------------
POSTGRES_VERSION=16-alpine
POSTGRES_PORT=5432
POSTGRES_USER=medrag
POSTGRES_DB=medrag
POSTGRES_PASSWORD=__GENERATE__

# ---------------- Redis（任务队列、进度、会话缓存）----------------
REDIS_VERSION=7.4-alpine
REDIS_PORT=6379
REDIS_PASSWORD=__GENERATE__

# ---------------- Neo4j（知识图谱）----------------
NEO4J_VERSION=5.26-community
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PASSWORD=__GENERATE__
NEO4J_HEAP_SIZE=1G
NEO4J_PAGECACHE_SIZE=512m
